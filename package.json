{
  "name": "wholphin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:tokens": "node tools/gen-tokens.mjs",
    "gen:strings": "tsx tools/gen-strings.ts",
    "gen:preferences": "tsx tools/gen-preferences.ts",
    "gen:licenses": "tsx tools/gen-licenses.ts",
    "gen": "npm run gen:tokens && npm run gen:strings && npm run gen:preferences && npm run gen:licenses",
    "shots": "tsx tools/shots/cli.ts",
    "conversation": "node tools/export-conversation.mjs",
    "map": "node tools/gen-code-map.mjs",
    "shots:compare": "tsx tools/shots/cli.ts --compare",
    "shots:quick": "tsx tools/shots/cli.ts --theme PURPLE --viewport desktop,phone",
    "ts:up": "node tools/testserver/setup.mjs up",
    "ts:down": "node tools/testserver/setup.mjs down",
    "ts:reset": "node tools/testserver/setup.mjs reset",
    "ts:verify": "node tools/testserver/setup.mjs verify",
    "ts:guide": "node tools/testserver/setup.mjs guide",
    "postinstall": "node tools/quiet-playwright.mjs",
    "ref:emu": "node tools/refshots/emulator.mjs",
    "ref:shots": "node tools/refshots/capture.mjs",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:keyboard": "playwright test --project=keyboard",
    "e2e:phone": "playwright test --project=phone",
    "e2e:writes": "playwright test --project=writes",
    "e2e:flaky": "playwright test --repeat-each=3 --grep-invert @writes",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "e2e:list": "playwright test --list",
    "start": "node server/index.ts",
    "serve:build": "vite build --config server/vite.config.ts",
    "docker:build": "docker build -t wholphin-web .",
    "docker:run": "docker run --rm -p 8080:8080 -e JELLYFIN_URL wholphin-web"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "@jellyfin/sdk": "^1.0.2",
    "@tanstack/react-query": "^5.107.2",
    "@tanstack/react-virtual": "^3.14.26",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.4",
    "hono": "^4.13.19",
    "i18next": "^27.1.4",
    "jassub": "^2.5.38",
    "libpgs": "^0.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router": "^8.5.1",
    "rvfc-polyfill": "file:vendor/rvfc-polyfill",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-xml-parser": "^5.12.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "postcss-pxtorem": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "GPL-2.0-only",
  "description": "Unofficial web port of Wholphin, the Android TV client for Jellyfin",
  "overrides": {
    "rvfc-polyfill": "$rvfc-polyfill"
  }
}
