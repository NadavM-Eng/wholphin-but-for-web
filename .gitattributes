# Text files are LF in the repository and in working copies (matches .editorconfig).
* text=auto eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.wasm binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.ogg binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary

# Windows scripts keep CRLF (matches .editorconfig)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
